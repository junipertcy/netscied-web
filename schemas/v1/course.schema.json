{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netscied.tw/api/v1/schema/source/course.schema.json",
  "title": "Source record: netscied.tw course record (catalog/courses/<id>.yaml)",
  "description": "One recurring course at a university in Taiwan, with one entry per semester offering. Every offering needs an evidence URL and the date it was last verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "university",
    "department",
    "title",
    "category",
    "relevance",
    "offering_type",
    "level",
    "languages",
    "inclusion_note",
    "provenance",
    "offerings"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/slug"
      }
    },
    "university": {
      "description": "A key in catalog/vocab/universities.yaml.",
      "$ref": "common.schema.json#/$defs/vocabId"
    },
    "department": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-Hant"
      ],
      "properties": {
        "zh-Hant": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "en": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        }
      }
    },
    "course_code": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "network-science",
        "social-network-analysis",
        "graph-theory",
        "graph-ml"
      ]
    },
    "relevance": {
      "enum": [
        "core",
        "partial"
      ]
    },
    "offering_type": {
      "enum": [
        "credit",
        "module",
        "non-credit",
        "ocw"
      ]
    },
    "level": {
      "enum": [
        "undergraduate",
        "master",
        "doctoral",
        "mixed",
        "professional",
        "non-credit"
      ]
    },
    "languages": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "enum": [
          "zh",
          "en",
          "nan",
          "hak"
        ]
      },
      "description": "Languages of instruction. Empty only when unverified.fields lists languages (owner decision A4)."
    },
    "inclusion_note": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historical": {
      "description": "Kept for history (freshness label 歷史紀錄), for example the 2018 NCKU STAT1021 lectures.",
      "type": "boolean"
    },
    "related_page": {
      "description": "A site page about this course, for example /stat1021/.",
      "type": "string",
      "pattern": "^/[a-z0-9/-]*/$"
    },
    "disclosure": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "found_via",
        "added",
        "reviewed"
      ],
      "properties": {
        "found_via": {
          "enum": [
            "manual",
            "official-export",
            "open-data",
            "submission",
            "research"
          ]
        },
        "added": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "reviewed": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "source_attribution": {
          "description": "Attribution required by an open-data source (for the ISAC CSV, its 顯名聲明).",
          "type": "string"
        }
      }
    },
    "offerings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/offering"
      }
    },
    "unverified": {
      "$ref": "#/$defs/unverified"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "offering_type": {
            "enum": [
              "credit",
              "module"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "offerings": {
            "items": {
              "required": [
                "term"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "offering_type": {
            "const": "non-credit"
          }
        }
      },
      "then": {
        "properties": {
          "offerings": {
            "items": {
              "required": [
                "start",
                "end"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "unverified": {
              "properties": {
                "fields": {
                  "contains": {
                    "const": "languages"
                  }
                }
              },
              "required": [
                "fields"
              ]
            }
          },
          "required": [
            "unverified"
          ]
        }
      },
      "then": {
        "properties": {
          "languages": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructors",
        "evidence_url"
      ],
      "properties": {
        "term": {
          "description": "<學年度>-<學期>: 114-1, 114-2, or 114-S for summer.",
          "type": "string",
          "pattern": "^[0-9]{2,3}-(1|2|S)$"
        },
        "start": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "instructors": {
          "description": "As published by the university. Empty means 未列出 (removed on request), or 待確認 when unverified.fields lists instructors.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "name_en": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "instructor",
                  "co-instructor",
                  "guest",
                  "coordinator"
                ]
              }
            }
          }
        },
        "evidence_url": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "verified_on": {
          "$ref": "common.schema.json#/$defs/date",
          "description": "The date the maintainer last opened evidence_url and confirmed the offering. Absent only when unverified.fields lists offering."
        },
        "syllabus_url": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "archive_url": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "note": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "unverified": {
          "$ref": "#/$defs/unverified"
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "unverified": {
                  "properties": {
                    "fields": {
                      "contains": {
                        "const": "offering"
                      }
                    }
                  },
                  "required": [
                    "fields"
                  ]
                }
              },
              "required": [
                "unverified"
              ]
            }
          },
          "then": {
            "required": [
              "verified_on"
            ]
          }
        }
      ]
    },
    "internationalList": {
      "description": "catalog/international.yaml: courses and materials from outside Taiwan carried over from the old /refs page, shown at /courses/#international and kept out of the table, the search index and the API.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "institution",
          "url",
          "kind",
          "checked_on"
        ],
        "properties": {
          "title": {
            "$ref": "common.schema.json#/$defs/textAny"
          },
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "instructor": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "doi": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "archived": {
            "type": "boolean",
            "description": "true when the original is gone and archive_url is the link to show"
          },
          "archive_url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "kind": {
            "enum": [
              "course",
              "material"
            ]
          },
          "note": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "checked_on": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "status": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "archived": {
              "const": true
            }
          },
          "required": [
            "archived"
          ]
        },
        "then": {
          "required": [
            "archive_url"
          ]
        }
      }
    },
    "rejectedList": {
      "description": "catalog/courses-rejected.yaml: candidates looked at and excluded, with a reason, so they are not reconsidered every semester (course-catalog spec, Inclusion rules).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "university",
          "reason",
          "url",
          "checked_on"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "university": {
            "$ref": "common.schema.json#/$defs/vocabId"
          },
          "code": {
            "type": "string"
          },
          "term": {
            "type": "string",
            "pattern": "^[0-9]{2,3}-(1|2|S)$"
          },
          "reason": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "checked_on": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "unverified": {
      "description": "Facts that could not be confirmed at their source (owner decision A4, 2026-11-04): they are left blank or kept out, never guessed, and the check date is recorded.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "checked_on"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "languages",
              "offering",
              "instructors",
              "code"
            ]
          }
        },
        "checked_on": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "note": {
          "$ref": "common.schema.json#/$defs/text"
        }
      }
    }
  },
  "$comment": "Describes the human-edited source files in the repository (catalog/, content/), not the API responses; those are described by /api/v1/schema/*-record.schema.json and friends."
}
