{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netscied.tw/api/v1/schema/news.schema.json",
  "title": "netscied.tw news item (front matter of content/news/<id>.md)",
  "description": "The Markdown body after the front matter is the Mandarin text. The id is the permanent anchor on /news/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "title"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "$ref": "common.schema.json#/$defs/date" },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-Hant"],
      "properties": {
        "zh-Hant": { "type": "string", "minLength": 2 },
        "en": { "type": "string", "minLength": 2 }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasets": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" } },
        "courses": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" } }
      }
    }
  }
}
